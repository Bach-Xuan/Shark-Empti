{
  "name": "shark-empti",
  "version": "1.15.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "ai:health": "node --env-file-if-exists=.env --import tsx scripts/check-openrouter.ts",
    "ai:smoke": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/smoke-test-openrouter.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "firebase emulators:exec --project demo-shark-empti --only auth,firestore \"playwright test\"",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --project demo-shark-empti --only auth,firestore \"vitest run --config vitest.integration.config.mts tests/firebase.rules.test.ts\"",
    "test:integration": "firebase emulators:exec --project demo-shark-empti --only auth,firestore \"vitest run --config vitest.integration.config.mts\"",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "report:bundle": "node scripts/bundle-report.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "report:performance": "node --import tsx scripts/performance-baseline.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tensorflow/tfjs": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "katex": "0.18.5",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^24",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.1.0",
    "jsdom": "30.0.1",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "~6.0.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
