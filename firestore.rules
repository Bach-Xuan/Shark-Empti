rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function writableAccount(userId) {
      return owner(userId)
        && !exists(/databases/$(database)/documents/_accountLocks/$(userId))
        && (!exists(/databases/$(database)/documents/_serviceState/maintenance)
          || get(/databases/$(database)/documents/_serviceState/maintenance).data.active != true
          || get(/databases/$(database)/documents/_serviceState/maintenance).data.expiresAtMs <= request.time.toMillis());
    }
    function writableOwner(userId) {
      let consent = get(/databases/$(database)/documents/_serviceConsents/$(userId)).data;
      return writableAccount(userId) && consent.policyVersion == '2' && consent.minimumAge == 16
        && consent.acceptedAt is timestamp && consent.acceptedAt.toMillis() > 0 && consent.acceptedAt <= request.time;
    }
    function validText(value, maximum) { return value is string && value.size() > 0 && value.size() <= maximum && value.matches('[\\s\\S]*\\S[\\s\\S]*'); }
    function validPhoto(value) {
      return value is string && value.size() <= 2048 && (value == '' || value.matches('(?i)https?://.*'));
    }
    function publicProfile(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt', 'sharkCoins'])
        && (!('displayName' in data) || validText(data.displayName, 200))
        && (!('photoURL' in data) || validPhoto(data.photoURL))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 20000))
        && (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('sharkCoins' in data) || (data.sharkCoins is int && data.sharkCoins >= 0 && data.sharkCoins <= 9007199254740991));
    }
    function validProfileCreate(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && publicProfile(data) && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function validProfileUpdate(data) {
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt', 'email'])
        && !('email' in data) && data.updatedAt == request.time
        && (!changed.hasAny(['displayName']) || validText(data.displayName, 200))
        && (!changed.hasAny(['photoURL']) || validPhoto(data.photoURL))
        && (!changed.hasAny(['bio']) || (data.bio is string && data.bio.size() <= 20000))
        && (!changed.hasAny(['createdAt']) || (data.createdAt is timestamp && data.createdAt <= request.time
          && (!(resource.data.get('createdAt', null) is timestamp) || data.createdAt == resource.data.createdAt)));
    }
    function validNotes(data) {
      return data.keys().hasAll(['content', 'updatedAt']) && data.content is string && data.content.size() <= 20000
        && data.updatedAt == request.time;
    }
    function validActivity(data, before) {
      let after = data.activeDays;
      let added = after.keys().removeAll(before.keys());
      let difference = after.diff(before);
      // Existing legacy leaves remain untouched. Each write adds one true leaf
      // or repeats a day, so stale/offline devices cannot replace the map.
      return data.keys().hasAll(['activeDays', 'updatedAt']) && after is map && before is map
        && data.updatedAt == request.time && (after.size() <= 5000 || after.size() <= before.size())
        && difference.removedKeys().size() == 0 && difference.changedKeys().size() == 0
        && (added.size() == 0 || (added.size() == 1 && after[added[0]] == true
          && added[0].matches('([12][0-9]{3}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([12][0-9](0[48]|[2468][048]|[13579][26])|(12|16|20|24|28)00)-02-29)')));
    }
    function validAuthor(data) {
      return validText(data.authorId, 128) && validText(data.authorName, 200)
        && data.authorPhoto is string && data.authorPhoto.size() <= 2048
        && (data.authorPhoto == '' || data.authorPhoto.matches('https?://.*'))
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
    }
    function validLikes(data) {
      return data.likedBy is list && data.likesCount is int && data.likesCount >= 0
        && data.likesCount == data.likedBy.size() && data.likedBy.size() == data.likedBy.toSet().size();
    }
    function validPost() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'content', 'subject', 'authorId', 'authorName', 'authorPhoto', 'createdAt', 'likedBy', 'likesCount', 'commentsCount'])
        && data.keys().hasOnly(['title', 'content', 'subject', 'authorId', 'authorName', 'authorPhoto', 'createdAt', 'updatedAt', 'likedBy', 'likesCount', 'commentsCount'])
        && validAuthor(data) && validLikes(data) && validText(data.title, 200)
        && validText(data.content, 20000) && validText(data.subject, 100)
        && data.commentsCount is int && data.commentsCount >= 0;
    }
    function validComment(postId) {
      let data = request.resource.data;
      return data.keys().hasAll(['postId', 'content', 'authorId', 'authorName', 'authorPhoto', 'createdAt', 'likedBy', 'likesCount'])
        && data.keys().hasOnly(['postId', 'content', 'authorId', 'authorName', 'authorPhoto', 'createdAt', 'updatedAt', 'likedBy', 'likesCount'])
        && data.postId == postId && validAuthor(data) && validLikes(data) && validText(data.content, 2000);
    }
    function livePost(postId) {
      return exists(/databases/$(database)/documents/posts/$(postId))
        && !exists(/databases/$(database)/documents/_forumDeletions/$(postId));
    }
    function validLikeUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let added = request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet());
      let removed = resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet());
      return request.resource.data.likedBy is list && request.resource.data.likesCount is int && request.resource.data.likesCount >= 0 && request.resource.data.likedBy.size() == request.resource.data.likedBy.toSet().size() && changed.hasOnly(['likedBy', 'likesCount']) && (
        (added.size() == 1 && added.hasOnly([request.auth.uid]) && removed.size() == 0 && request.resource.data.likesCount == resource.data.likesCount + 1) ||
        (removed.size() == 1 && removed.hasOnly([request.auth.uid]) && added.size() == 0 && request.resource.data.likesCount == resource.data.likesCount - 1)
      );
    }

    // Server-controlled transport state. Browser access is always denied.
    match /_serviceConsents/{document=**} { allow read, write: if false; }
    match /_accountJobs/{document=**} { allow read, write: if false; }
    match /_accountLocks/{document=**} { allow read, write: if false; }
    match /_deletionJournal/{document=**} { allow read, write: if false; }
    match /_jobWorkerState/{document=**} { allow read, write: if false; }
    match /_jobBudgets/{document=**} { allow read, write: if false; }
    match /_serviceState/{document=**} { allow read, write: if false; }
    match /_aiGenerations/{document=**} { allow read, write: if false; }
    match /_aiQuota/{document=**} { allow read, write: if false; }
    match /_requestBudgets/{document=**} { allow read, write: if false; }
    match /_arenaSessions/{document=**} { allow read, write: if false; }
    match /_arenaAnswerKeys/{document=**} { allow read, write: if false; }
    match /_arenaLegacyBackups/{document=**} { allow read, write: if false; }
    match /_arenaEligibility/{document=**} { allow read, write: if false; }
    match /_communityReports/{document=**} { allow read, write: if false; }
    match /_moderationArchives/{document=**} { allow read, write: if false; }
    match /_moderationActions/{document=**} { allow read, write: if false; }
    match /_accountRequests/{document=**} { allow read, write: if false; }
    // Minimal owner-visible recovery queue; only the server can mutate tombstones.
    match /_forumDeletions/{postId} {
      allow read: if owner(resource.data.authorId);
      allow write: if false;
    }

    match /users/{userId} {
      // Known-UID lookup only. Legacy profiles with private/unknown fields are
      // owner-only until repaired; Rules cannot hide individual document fields.
      allow get: if owner(userId) || (signedIn() && publicProfile(resource.data));
      allow list: if false;
      // Profile provisioning/legacy email removal precedes consent. Learning
      // descendants below require a current server-owned acknowledgement.
      allow create: if writableAccount(userId) && validProfileCreate(request.resource.data);
      allow update: if writableAccount(userId) && validProfileUpdate(request.resource.data);
      allow delete: if false;
      match /{collection}/{document=**} {
        allow read: if owner(userId);
        // Preserve access and explicit deletion of legacy descendants. New or
        // updated complex learning records use schema-validated server APIs.
        allow delete: if writableAccount(userId) && !(collection in ['forumReactions', 'arenaRankings']);
      }
      match /notes/main {
        allow create: if writableOwner(userId) && request.resource.data.keys().hasOnly(['content', 'updatedAt']) && validNotes(request.resource.data);
        allow update: if writableOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt']) && validNotes(request.resource.data);
      }
      match /activity/main {
        allow create: if writableOwner(userId) && request.resource.data.keys().hasOnly(['activeDays', 'updatedAt'])
          && request.resource.data.activeDays.size() == 1 && validActivity(request.resource.data, {});
        allow update: if writableOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeDays', 'updatedAt'])
          && validActivity(request.resource.data, resource.data.get('activeDays', {}));
      }
    }

    match /posts/{postId} {
      allow read: if false;
      // All contribution/reaction mutations pass through budgeted Admin APIs.
      allow create, update, delete: if false;
      match /comments/{commentId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }

    match /forumPosts/{postId} {
      allow get: if !exists(/databases/$(database)/documents/forumPosts/$(postId)) || resource.data.privacyVersion == 1;
      allow list: if resource.data.privacyVersion == 1;
      allow write: if false;
      match /comments/{commentId} {
        allow read: if resource.data.privacyVersion == 1 && exists(/databases/$(database)/documents/forumPosts/$(postId))
          && get(/databases/$(database)/documents/forumPosts/$(postId)).data.privacyVersion == 1;
        allow write: if false;
      }
    }

    match /arenaExams/{examId} {
      allow read: if resource.data.schemaVersion == 2;
      // Full per-question/cross-field validation is enforced by the authenticated
      // server creation route. Rules cannot iterate arbitrary question arrays.
      allow create, update: if false;
      allow delete: if false;
      match /attempts/{attemptId} {
        allow read, write: if false;
      }
      match /rankings/{rankingId} {
        allow read: if resource.data.privacyVersion == 1 && exists(/databases/$(database)/documents/arenaExams/$(examId))
          && get(/databases/$(database)/documents/arenaExams/$(examId)).data.schemaVersion == 2;
        allow create: if false;
        allow update, delete: if false;
      }
    }
  }
}
