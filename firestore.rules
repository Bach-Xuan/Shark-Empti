rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function validText(value, maximum) { return value is string && value.size() > 0 && value.size() <= maximum; }
    function validPost() { return validText(request.resource.data.title, 200) && validText(request.resource.data.content, 20000) && validText(request.resource.data.subject, 100); }
    function validLikeUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let added = request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet());
      let removed = resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet());
      return request.resource.data.likedBy is list && request.resource.data.likesCount is int && request.resource.data.likesCount >= 0 && request.resource.data.likedBy.size() == request.resource.data.likedBy.toSet().size() && changed.hasOnly(['likedBy', 'likesCount']) && (
        (added.size() == 1 && added.hasOnly([request.auth.uid]) && removed.size() == 0 && request.resource.data.likesCount == resource.data.likesCount + 1) ||
        (removed.size() == 1 && removed.hasOnly([request.auth.uid]) && added.size() == 0 && request.resource.data.likesCount == resource.data.likesCount - 1)
      );
    }

    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if owner(userId) && !request.resource.data.keys().hasAny(['sharkCoins']);
      allow update: if owner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharkCoins']);
      allow delete: if owner(userId);
      match /{collection}/{document=**} {
        allow read, write: if owner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && validPost() && request.resource.data.authorId == request.auth.uid && request.resource.data.likesCount == 0 && request.resource.data.commentsCount == 0 && request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0;
      allow update: if signedIn() && (validLikeUpdate() || (resource.data.authorId == request.auth.uid && validPost() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'subject', 'updatedAt'])));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /comments/{commentId} {
        allow read: if true;
        allow create: if false;
        allow update: if signedIn() && (validLikeUpdate() || (resource.data.authorId == request.auth.uid && validText(request.resource.data.content, 2000) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt'])));
        allow delete: if false;
      }
    }

    match /arenaExams/{examId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.totalAttempts == 0;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'config', 'questions']);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /attempts/{attemptId} {
        allow read: if true;
        allow create: if false;
        allow update, delete: if false;
      }
    }
  }
}
