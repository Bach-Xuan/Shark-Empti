rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function validText(value, maximum) { return value is string && value.size() > 0 && value.size() <= maximum && value.matches('[\\s\\S]*\\S[\\s\\S]*'); }
    function validAuthor(data) {
      return validText(data.authorId, 128) && validText(data.authorName, 200)
        && data.authorPhoto is string && data.authorPhoto.size() <= 2048
        && (data.authorPhoto == '' || data.authorPhoto.matches('https?://.*'))
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
    }
    function validLikes(data) {
      return data.likedBy is list && data.likesCount is int && data.likesCount >= 0
        && data.likesCount == data.likedBy.size() && data.likedBy.size() == data.likedBy.toSet().size();
    }
    function validPost() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'content', 'subject', 'authorId', 'authorName', 'authorPhoto', 'createdAt', 'likedBy', 'likesCount', 'commentsCount'])
        && data.keys().hasOnly(['title', 'content', 'subject', 'authorId', 'authorName', 'authorPhoto', 'createdAt', 'updatedAt', 'likedBy', 'likesCount', 'commentsCount'])
        && validAuthor(data) && validLikes(data) && validText(data.title, 200)
        && validText(data.content, 20000) && validText(data.subject, 100)
        && data.commentsCount is int && data.commentsCount >= 0;
    }
    function validComment(postId) {
      let data = request.resource.data;
      return data.keys().hasAll(['postId', 'content', 'authorId', 'authorName', 'authorPhoto', 'createdAt', 'likedBy', 'likesCount'])
        && data.keys().hasOnly(['postId', 'content', 'authorId', 'authorName', 'authorPhoto', 'createdAt', 'updatedAt', 'likedBy', 'likesCount'])
        && data.postId == postId && validAuthor(data) && validLikes(data) && validText(data.content, 2000);
    }
    function livePost(postId) {
      return exists(/databases/$(database)/documents/posts/$(postId))
        && !exists(/databases/$(database)/documents/_forumDeletions/$(postId));
    }
    function validLikeUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let added = request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet());
      let removed = resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet());
      return request.resource.data.likedBy is list && request.resource.data.likesCount is int && request.resource.data.likesCount >= 0 && request.resource.data.likedBy.size() == request.resource.data.likedBy.toSet().size() && changed.hasOnly(['likedBy', 'likesCount']) && (
        (added.size() == 1 && added.hasOnly([request.auth.uid]) && removed.size() == 0 && request.resource.data.likesCount == resource.data.likesCount + 1) ||
        (removed.size() == 1 && removed.hasOnly([request.auth.uid]) && added.size() == 0 && request.resource.data.likesCount == resource.data.likesCount - 1)
      );
    }

    // Server-controlled transport state. Browser access is always denied.
    match /_aiGenerations/{document=**} { allow read, write: if false; }
    match /_aiQuota/{document=**} { allow read, write: if false; }
    // Minimal owner-visible recovery queue; only the server can mutate tombstones.
    match /_forumDeletions/{postId} {
      allow read: if owner(resource.data.authorId);
      allow write: if false;
    }

    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if owner(userId) && !request.resource.data.keys().hasAny(['sharkCoins']);
      allow update: if owner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharkCoins']);
      allow delete: if owner(userId);
      match /{collection}/{document=**} {
        allow read, write: if owner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/_forumDeletions/$(postId)) && validPost() && request.resource.data.createdAt == request.time && request.resource.data.authorId == request.auth.uid && request.resource.data.likesCount == 0 && request.resource.data.commentsCount == 0 && request.resource.data.likedBy.size() == 0;
      allow update: if signedIn() && livePost(postId) && validPost() && (validLikeUpdate() || (resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'subject', 'updatedAt'])));
      allow delete: if false;
      match /comments/{commentId} {
        allow read: if livePost(postId);
        allow create: if false;
        allow update: if signedIn() && livePost(postId) && validComment(postId) && (validLikeUpdate() || (resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt'])));
        allow delete: if false;
      }
    }

    match /arenaExams/{examId} {
      allow read: if true;
      // Full per-question/cross-field validation is enforced by the authenticated
      // server creation route. Rules cannot iterate arbitrary question arrays.
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /attempts/{attemptId} {
        allow read: if true;
        allow create: if false;
        allow update, delete: if false;
      }
    }
  }
}
