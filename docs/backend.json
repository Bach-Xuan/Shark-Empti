
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information stored in Firestore.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's preferred display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "description": "URL to the user's profile picture."
        },
        "bio": {
          "type": "string",
          "description": "Short biography or notes about the user."
        },
        "sharkCoins": {
          "type": "number",
          "description": "The user's earned shark coins."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The last time the profile was updated."
        }
      },
      "required": ["email"]
    },
    "ArenaExam": {
      "title": "Arena Exam",
      "description": "An exam created by a user for the Arena.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "config": { "type": "object" },
        "questions": { "type": "array" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "totalAttempts": { "type": "number" }
      },
      "required": ["title", "config", "authorId", "createdAt", "questions"]
    },
    "ArenaAttempt": {
      "title": "Arena Attempt",
      "description": "A user's attempt at an arena exam.",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "score": { "type": "number" },
        "duration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examId", "userId", "score", "duration", "createdAt"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/arenaExams/{examId}": {
      "schema": "ArenaExam",
      "description": "Arena exams collection."
    },
    "/arenaExams/{examId}/attempts/{attemptId}": {
      "schema": "ArenaAttempt",
      "description": "Attempts and leaderboard for an exam."
    }
  }
}
