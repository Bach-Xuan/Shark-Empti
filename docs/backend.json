{
  "$comment": "Descriptive data map, not an executable validation schema. Technical identifiers follow the source; editing this file changes no runtime behavior.",
  "x-version": "1.15.1",
  "x-authority": {
    "description": "Actual contracts: Firestore Rules, AI/API Zod schemas, history/profile readers and server-api.ts. Updating this file changes no validation, migration or access policy.",
    "documentation": "TECHNICAL_DOCUMENTATION.md",
    "configuration": "CONFIGURATION.md",
    "audit": "AUDIT_REPORT.md"
  },
  "$defs": {
    "FirestoreTimestamp": {
      "type": "object",
      "x-firestore-type": "Timestamp",
      "description": "Native Firestore timestamp; this is not a prescribed JSON serialization."
    },
    "QuizQuestion": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correct": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "difficulty": {
          "type": "string"
        }
      }
    },
    "QuizResult": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correct": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "difficulty": {
          "type": "string"
        },
        "userAnswer": {
          "type": "string"
        },
        "isCorrect": {
          "type": "boolean"
        },
        "timeTakenSeconds": {
          "type": "number"
        },
        "errorCategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "aiFeedback": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "entities": {
    "UserProfile": {
      "title": "User profile",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "photoURL": {
          "type": [
            "string",
            "null"
          ]
        },
        "bio": {
          "type": "string"
        },
        "sharkCoins": {
          "type": "number"
        },
        "createdAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        }
      },
      "description": "Profiles may be partial: Admin coin increments can create a record without email. Runtime reader and Rules define actual acceptance."
    },
    "QuizHistory": {
      "title": "Quiz history",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "quizResults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuizResult"
          }
        },
        "totalTime": {
          "type": "number"
        },
        "analysis": {
          "type": "object"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "lang": {
          "enum": [
            "vi",
            "en"
          ]
        },
        "schemaVersion": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "description": "New writes use 2. The reader treats absence as legacy version 1, supports both permanently and rejects unsupported versions."
        }
      },
      "description": "The writer persists userId and schemaVersion while the reader supplies the document ID separately. Legacy defaults come from history-schema.ts. Quiz completion awaits a stable-ID write, and the persistence DTO omits absent optional values."
    },
    "UserNotes": {
      "title": "Personal notes",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        }
      }
    },
    "UserActivity": {
      "title": "Calendar activity",
      "type": "object",
      "properties": {
        "activeDays": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Keys are local calendar dates YYYY-MM-DD."
        },
        "updatedAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        }
      },
      "description": "ActivityCalendar calls trackToday when ready. This records an active day, not proof of quiz completion."
    },
    "FlashcardSession": {
      "title": "Saved flashcard session",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "sourceType": {
          "enum": [
            "weak_point",
            "manual"
          ]
        },
        "sourceValue": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "front": {
                "type": "string"
              },
              "back": {
                "type": "string"
              }
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PracticeSession": {
      "title": "Saved practice session",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "concept": {
          "type": "string"
        },
        "questions": {
          "type": "array"
        },
        "userAnswers": {
          "type": "array"
        },
        "score": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ForumPost": {
      "title": "Forum post",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorPhoto": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        },
        "likesCount": {
          "type": "integer"
        },
        "likedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commentsCount": {
          "type": "integer"
        }
      },
      "description": "Post deletion currently does not cascade to comments; this map does not impose a retention or orphan-cleanup policy."
    },
    "ForumComment": {
      "title": "Forum comment",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorPhoto": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        },
        "likesCount": {
          "type": "integer"
        },
        "likedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ArenaExam": {
      "title": "Arena exam",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuizQuestion"
          }
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorPhoto": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        },
        "totalAttempts": {
          "type": "integer"
        }
      },
      "description": "Questions are unattempted questions, not learner results. Legacy documents are not assumed to satisfy this shape; runtime scoring guards determine whether an exam can be submitted securely."
    },
    "ArenaAttempt": {
      "title": "Arena attempt",
      "type": "object",
      "properties": {
        "examId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "userName": {
          "type": "string"
        },
        "userPhoto": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "createdAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        }
      }
    },
    "RequestReceipt": {
      "title": "Idempotency receipt",
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "result": {
          "type": "object"
        },
        "createdAt": {
          "$ref": "#/$defs/FirestoreTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/FirestoreTimestamp",
          "description": "New receipts expire seven days after creation; legacy records may lack this field pending backfill."
        }
      },
      "description": "Server hashes scope/UID/requestId to form the document ID. Admin dates are stored as Timestamp. Seven-day TTL and a field index exemption are declared in firestore.indexes.json; retained receipts remain replayable until asynchronous deletion. The 15 September 2026 check found TTL disabled; configuration application failed with IAM 403."
    }
  },
  "serverInterfaces": {
    "arenaSubmit": {
      "method": "POST",
      "path": "/api/arena/{examId}/submit",
      "runtime": "nodejs",
      "authentication": "Firebase ID token in Authorization: Bearer header",
      "request": {
        "answers": "string[]; maximum 500 entries, each maximum 2000 characters",
        "duration": "optional finite number; rounded and clamped to zero; currently client-supplied",
        "requestId": "optional UUID; enables idempotent replay"
      },
      "writes": [
        "/arenaExams/{examId}/attempts/{attemptId}",
        "/arenaExams/{examId}.totalAttempts",
        "/users/{uid}.sharkCoins",
        "/_requestReceipts/{hash} when requestId is supplied"
      ],
      "description": "Score, attempt creation, attempt count, reward and receipt are committed in one Admin transaction. Client-supplied duration is not a trusted server measurement."
    },
    "forumCommentCreate": {
      "method": "POST",
      "path": "/api/forum/{postId}/comments",
      "runtime": "nodejs",
      "authentication": "Firebase ID token in Authorization: Bearer header",
      "request": {
        "content": "trimmed string, 1 to 2000 characters",
        "requestId": "optional UUID; enables idempotent replay"
      },
      "writes": [
        "/posts/{postId}/comments/{commentId}",
        "/posts/{postId}.commentsCount",
        "/_requestReceipts/{hash} when requestId is supplied"
      ]
    },
    "forumCommentDelete": {
      "method": "DELETE",
      "path": "/api/forum/{postId}/comments?commentId={commentId}",
      "runtime": "nodejs",
      "authentication": "Firebase ID token in Authorization: Bearer header; comment author required",
      "writes": [
        "delete /posts/{postId}/comments/{commentId}",
        "/posts/{postId}.commentsCount"
      ],
      "description": "Deletion is transactional but does not currently use an idempotency receipt."
    },
    "aiServerActions": {
      "transport": "Next.js Server Actions",
      "operations": [
        "academic-validation",
        "generate-questions",
        "generate-flashcards",
        "generate-practice",
        "short-answer-analysis",
        "personalized-quiz-feedback",
        "ai-coaching-chatbot"
      ],
      "authentication": "No server-side caller authentication in the current source",
      "provider": "OpenRouter chat/completions",
      "validation": "Zod input/output validation plus operation-specific cross-field checks",
      "description": "Current fallback and timeout behavior is described in TECHNICAL_DOCUMENTATION.md. The remediation plan is not an implemented API contract."
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Profiles; authenticated reads, owner writes subject to Rules; coin changes use Admin."
    },
    "/users/{uid}/history/{id}": {
      "schema": "QuizHistory",
      "description": "Private history."
    },
    "/users/{uid}/notes/main": {
      "schema": "UserNotes",
      "description": "Private notes, one main document."
    },
    "/users/{uid}/activity/main": {
      "schema": "UserActivity",
      "description": "Private active-day map read/written by useUserActivity."
    },
    "/users/{uid}/flashcards/{id}": {
      "schema": "FlashcardSession",
      "description": "Private saved flashcards."
    },
    "/users/{uid}/practice/{id}": {
      "schema": "PracticeSession",
      "description": "Private saved practice."
    },
    "/posts/{postId}": {
      "schema": "ForumPost",
      "description": "Public feed; client mutations governed by Rules."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "ForumComment",
      "description": "Public comments; creation/deletion through Admin API, updates governed by Rules."
    },
    "/arenaExams/{examId}": {
      "schema": "ArenaExam",
      "description": "Public exams; client writes governed by Rules."
    },
    "/arenaExams/{examId}/attempts/{attemptId}": {
      "schema": "ArenaAttempt",
      "description": "Public leaderboard attempts; server-created."
    },
    "/_requestReceipts/{hash}": {
      "schema": "RequestReceipt",
      "description": "Admin-only receipts, no client Rule grant."
    }
  },
  "localStorage": {
    "shark_lang": "Shared UI language preference: en or vi",
    "shark_theme": "Shared UI theme preference: light or dark",
    "shark_roadmap_checks:{uid}": "UID-scoped boolean roadmap-check map",
    "shark_roadmap_checks": "Legacy unscoped key; retained but not automatically assigned to a user",
    "shark_chat_seen": "One-time AI chatbot introduction state",
    "shark_help_setup_seen": "One-time setup-view guidance state",
    "shark_help_dashboard_seen": "One-time dashboard guidance state",
    "shark_help_playground_seen": "One-time playground guidance state",
    "shark_help_forum_seen": "One-time Forum guidance state"
  },
  "x-derived-data": {
    "description": "Calendar month grouping derives from users/{uid}/activity/main.activeDays. Roadmap checks and language/theme use localStorage, not these collections."
  }
}
