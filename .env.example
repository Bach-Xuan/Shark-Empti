# Configuration template - Shark Empti 1.15.1
# Copy only if .env does not exist; do not overwrite local credentials.
# Do not commit .env; NEXT_PUBLIC_ variables are embedded in the browser bundle.
# Refer to docs/CONFIGURATION.md and docs/TECHNICAL_DOCUMENTATION.md.

# OpenRouter: server-side secret
OPENROUTER_API_KEY=your_openrouter_api_key
# The server-side attempt order is defined in src/ai/config/model.ts: Inkling -> Gemma -> Nemotron.
# Unset defaults to enabled outside production and disabled in production.
# Enable explicitly only in an approved staging environment or production canary.
# AI_GENERATION_PROTOCOL_ENABLED=true
# ai:health reads metadata only; ai:smoke verifies an actual request and response.

# Firebase Web configures the browser without granting Admin access; protect access through Rules and APIs.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin is required for Arena and Forum APIs outside the Emulator and must use the same project as the Web configuration.
# Never expose these as NEXT_PUBLIC_ variables.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# Preserve escaped newlines (\n); never paste a real key into this template or a report.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Test only; keep these values commented and do not enable them for production data or credentials.
# NEXT_PUBLIC_USE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-shark-empti
# GCLOUD_PROJECT=demo-shark-empti
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# OPENROUTER_TEST_URL=http://127.0.0.1:9098
# When the fixture is used, OPENROUTER_API_KEY is only a test-supplied placeholder key.
# API_KEYS/GEMINI_API_KEY/GOOGLE_GENAI_API_KEY are not required by the current transport.
