# Mau cau hinh / Configuration template - Shark Empti 1.15.1
# Chi copy neu .env chua ton tai; khong ghi de credential local.
# Copy only when .env does not exist; do not overwrite local credentials.
# Khong commit .env; bien NEXT_PUBLIC_ duoc dua vao browser bundle.
# Never commit .env; NEXT_PUBLIC_ values are embedded in browser bundles.
# Xem / See docs/CONFIGURATION.md and docs/TECHNICAL_DOCUMENTATION.md.

# OpenRouter: secret phia server / server-side secret
OPENROUTER_API_KEY=your_openrouter_api_key
# Thu tu fallback nam trong src/ai/config/model.ts: Inkling -> Gemma -> Nemotron.
# Fallback order is in src/ai/config/model.ts: Inkling -> Gemma -> Nemotron.
# ai:health chi doc metadata; ai:smoke moi kiem tra request/response that.
# ai:health reads metadata only; ai:smoke exercises a real request/response.

# Firebase Web: cau hinh browser, khong cap quyen Admin; bao ve bang Rules/API.
# Browser configuration, not Admin credentials; protect access using Rules/APIs.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin: bat buoc cho API Arena/Forum ngoai Emulator; cung project voi Web.
# Required for non-emulator Arena/Forum APIs; must match the Web project.
# Khong dat duoi NEXT_PUBLIC_ / Never expose these as NEXT_PUBLIC_ variables.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# Giu newline escaped (\n); khong paste key that vao template/bao cao.
# Keep escaped newlines (\n); never paste a real key into this template/reports.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Test only - commented deliberately; scripts/Playwright supply these for demo.
# Chi cho test - de comment; khong bat cho du lieu/credential production.
# NEXT_PUBLIC_USE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-shark-empti
# GCLOUD_PROJECT=demo-shark-empti
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# OPENROUTER_TEST_URL=http://127.0.0.1:9098
# Khi dung fixture, OPENROUTER_API_KEY chi la key gia do test cap.
# The fixture uses a fake OPENROUTER_API_KEY supplied by the test configuration.
# Khong can API_KEYS/GEMINI_API_KEY/GOOGLE_GENAI_API_KEY cho transport hien tai.
# API_KEYS/GEMINI_API_KEY/GOOGLE_GENAI_API_KEY are not used by the current transport.
